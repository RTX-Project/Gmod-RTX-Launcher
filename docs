/* ==========================================
   RTX Launcher — CSS Design System
   Modern dark theme with neon green accents
   ========================================== */

/* --- CSS Variables --- */
:root {
    --bg-primary: #050a0e;
    --bg-secondary: #0a1118;
    --bg-tertiary: #0f1923;
    --bg-card: rgba(15, 25, 35, 0.6);
    --bg-card-hover: rgba(20, 35, 50, 0.8);

    --text-primary: #e8edf2;
    --text-secondary: #8899aa;
    --text-muted: #556677;

    --accent-green: #00ff88;
    --accent-cyan: #00d4ff;
    --accent-purple: #a855f7;
    --accent-green-dim: rgba(0, 255, 136, 0.15);
    --accent-cyan-dim: rgba(0, 212, 255, 0.1);

    --gradient-main: linear-gradient(135deg, #00ff88, #00d4ff);
    --gradient-glow: linear-gradient(135deg, rgba(0,255,136,0.4), rgba(0,212,255,0.4));
    --gradient-card: linear-gradient(135deg, rgba(0,255,136,0.05), rgba(0,212,255,0.05));

    --border-color: rgba(255, 255, 255, 0.06);
    --border-glow: rgba(0, 255, 136, 0.2);

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --radius-xl: 28px;

    --shadow-sm: 0 2px 8px rgba(0,0,0,0.3);
    --shadow-md: 0 8px 32px rgba(0,0,0,0.4);
    --shadow-lg: 0 16px 64px rgba(0,0,0,0.5);
    --shadow-glow: 0 0 40px rgba(0,255,136,0.15);

    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', monospace;

    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-base: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);

    --nav-height: 72px;
    --container-max: 1200px;
}

/* --- Reset & Base --- */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

body {
    font-family: var(--font-body);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    max-width: 100%;
    display: block;
}

button {
    font-family: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
}

/* --- Particles Canvas --- */
#particles-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
}

/* --- Container --- */
.container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
}

/* --- Scrollbar --- */
::-webkit-scrollbar {
    width: 8px;
}
::-webkit-scrollbar-track {
    background: var(--bg-primary);
}
::-webkit-scrollbar-thumb {
    background: rgba(0, 255, 136, 0.2);
    border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 255, 136, 0.35);
}

/* ==========================================
   NAVIGATION
   ========================================== */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    z-index: 1000;
    transition: var(--transition-base);
    backdrop-filter: blur(0px);
    border-bottom: 1px solid transparent;
}

.navbar.scrolled {
    background: rgba(5, 10, 14, 0.85);
    backdrop-filter: blur(20px) saturate(1.5);
    border-bottom-color: var(--border-color);
}

.nav-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10;
}

.logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
}

.logo-accent {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
}

.nav-link {
    padding: 8px 16px;
    font-size: 0.9rem;
    font-weight: 450;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
    position: relative;
}

.nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 20px;
    height: 2px;
    background: var(--gradient-main);
    border-radius: 1px;
    transition: transform var(--transition-fast);
}

.nav-link:hover::after {
    transform: translateX(-50%) scaleX(1);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Mobile Nav Toggle */
.nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    z-index: 10;
}

.nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 1px;
    transition: var(--transition-fast);
}

.nav-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
}
.nav-toggle.active span:nth-child(2) {
    opacity: 0;
}
.nav-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
}

/* ==========================================
   BUTTONS
   ========================================== */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 550;
    border-radius: var(--radius-md);
    transition: var(--transition-base);
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
}

.btn-sm {
    padding: 8px 18px;
    font-size: 0.85rem;
}

.btn-lg {
    padding: 14px 32px;
    font-size: 1rem;
}

.btn-primary {
    background: var(--gradient-main);
    color: #050a0e;
    font-weight: 650;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.2), 0 4px 15px rgba(0, 0, 0, 0.3);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(0, 255, 136, 0.35), 0 8px 25px rgba(0, 0, 0, 0.4);
}

.btn-primary:active {
    transform: translateY(0);
}

.btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: 0.6s;
}

.btn-primary:hover::before {
    left: 100%;
}

.btn-outline {
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    background: transparent;
}

.btn-outline:hover {
    border-color: var(--border-glow);
    color: var(--text-primary);
    background: rgba(0, 255, 136, 0.05);
    transform: translateY(-1px);
}

.btn-ghost {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
}

.btn-ghost:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
}

.btn-disabled {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    cursor: not-allowed !important;
    opacity: 0.6;
    pointer-events: auto;
    font-size: 0.85em;
}

.btn-disabled:hover {
    transform: none;
    box-shadow: none;
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
}

.btn-disabled::before {
    display: none;
}

.btn-disabled svg {
    opacity: 0.5;
}

/* ==========================================
   GRADIENT TEXT
   ========================================== */
.gradient-text {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* ==========================================
   HERO SECTION
   ========================================== */
.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-height) + 40px) 24px 60px;
    overflow: hidden;
    z-index: 1;
}

.hero-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(0, 255, 136, 0.08) 0%, rgba(0, 212, 255, 0.04) 40%, transparent 70%);
    pointer-events: none;
    animation: pulseGlow 6s ease-in-out infinite;
}

@keyframes pulseGlow {
    0%, 100% { opacity: 0.7; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.1); }
}

.hero-grid {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(0, 255, 136, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 255, 136, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 20%, transparent 70%);
    pointer-events: none;
}

.hero-content {
    text-align: center;
    max-width: 800px;
    position: relative;
    z-index: 2;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: rgba(0, 255, 136, 0.08);
    border: 1px solid rgba(0, 255, 136, 0.15);
    border-radius: 100px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent-green);
    margin-bottom: 28px;
    letter-spacing: 0.02em;
}

.badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-green);
    border-radius: 50%;
    animation: blink 2s ease-in-out infinite;
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

.hero-title {
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
}

.hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-secondary);
    max-width: 580px;
    margin: 0 auto 36px;
    line-height: 1.7;
}

.hero-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 56px;
    flex-wrap: wrap;
}

/* Hero Stats */
.hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
}

.stat {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-number {
    font-size: 2rem;
    font-weight: 800;
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
}

.stat-suffix {
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 450;
    margin-top: 4px;
}

.stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-color);
}

/* ==========================================
   HERO MOCKUP (App Preview)
   ========================================== */
.hero-visual {
    width: 100%;
    max-width: 900px;
    margin: 60px auto 0;
    perspective: 1200px;
    position: relative;
    z-index: 2;
}

.hero-mockup {
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    overflow: hidden;
    box-shadow:
        var(--shadow-lg),
        0 0 80px rgba(0, 255, 136, 0.06),
        inset 0 1px 0 rgba(255,255,255,0.03);
    transform: rotateX(4deg) scale(0.97);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-mockup:hover {
    transform: rotateX(0deg) scale(1);
}

.mockup-header {
    display: flex;
    align-items: center;
    padding: 14px 20px;
    background: rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid var(--border-color);
    gap: 12px;
}

.mockup-dots {
    display: flex;
    gap: 7px;
}

.mockup-dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
}

.mockup-dots span:nth-child(1) { background: #ff5f57; }
.mockup-dots span:nth-child(2) { background: #ffbd2e; }
.mockup-dots span:nth-child(3) { background: #28ca42; }

.mockup-title {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
}

.mockup-body {
    display: flex;
    min-height: 320px;
}

.mockup-sidebar {
    width: 180px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.2);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.mockup-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    color: var(--text-muted);
    transition: var(--transition-fast);
    cursor: default;
}

.mockup-nav-item.active {
    background: rgba(0, 255, 136, 0.08);
    color: var(--accent-green);
}

.mockup-main {
    flex: 1;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.mockup-card {
    background: var(--gradient-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    overflow: hidden;
}

.glow-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 30%, rgba(0,255,136,0.05), transparent 50%);
    animation: rotateGlow 10s linear infinite;
}

@keyframes rotateGlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.mockup-card-icon {
    font-size: 2rem;
}

.mockup-card-title {
    font-size: 1.1rem;
    font-weight: 650;
    position: relative;
}

.mockup-card-subtitle {
    font-size: 0.8rem;
    color: var(--accent-green);
    font-weight: 450;
    position: relative;
}

.mockup-progress {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
    margin-top: 8px;
}

.mockup-progress-bar {
    height: 100%;
    width: 100%;
    background: var(--gradient-main);
    border-radius: 2px;
    animation: progressFill 3s ease-in-out infinite;
}

@keyframes progressFill {
    0% { width: 0%; }
    50% { width: 100%; }
    100% { width: 100%; }
}

.mockup-btn {
    margin-top: 8px;
    padding: 10px 32px;
    background: var(--gradient-main);
    color: var(--bg-primary);
    font-weight: 650;
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
    transition: var(--transition-base);
    position: relative;
    cursor: default;
    box-shadow: 0 0 20px rgba(0,255,136,0.15);
}

.mockup-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.mockup-info-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.info-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
}

.info-value {
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-mono);
}

.status-on {
    color: var(--accent-green);
}

/* ==========================================
   SECTION STYLING
   ========================================== */
.section {
    padding: 120px 0;
    position: relative;
    z-index: 1;
}

.section-header {
    text-align: center;
    margin-bottom: 64px;
}

.section-badge {
    display: inline-block;
    padding: 5px 16px;
    background: var(--accent-green-dim);
    border: 1px solid rgba(0, 255, 136, 0.12);
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 550;
    color: var(--accent-green);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 20px;
}

.section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 16px;
}

.section-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
}

/* ==========================================
   FEATURES GRID
   ========================================== */
.features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    transition: var(--transition-base);
    position: relative;
    overflow: hidden;
}

.feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--gradient-main);
    opacity: 0;
    transition: opacity var(--transition-base);
}

.feature-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-glow);
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
}

.feature-card:hover::before {
    opacity: 1;
}

.feature-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-green-dim);
    border-radius: var(--radius-md);
    margin-bottom: 20px;
    color: var(--accent-green);
    transition: var(--transition-base);
}

.feature-card:hover .feature-icon {
    background: rgba(0, 255, 136, 0.2);
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.1);
}

.feature-title {
    font-size: 1.1rem;
    font-weight: 650;
    margin-bottom: 10px;
}

.feature-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
}

/* ==========================================
   COMPARISON SECTION
   ========================================== */
.comparison-showcase {
    max-width: 900px;
    margin: 0 auto 56px;
}

.comparison-slider {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
    height: 420px;
    cursor: ew-resize;
    user-select: none;
}

.comparison-side {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.comparison-before {
    left: 0;
    right: 0;
    z-index: 1;
}

.comparison-after {
    left: 0;
    right: 0;
    z-index: 2;
    clip-path: inset(0 0 0 50%);
}

.comparison-scene {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}

/* Before Scene (No RTX) */
.before-scene {
    background: linear-gradient(180deg, #2a2a2a 0%, #1a1a1a 100%);
}

.scene-floor {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 45%;
    background: linear-gradient(180deg, #3a3a3a, #2a2a2a);
}

.rtx-floor {
    background: linear-gradient(180deg, #2a3540, #1a252e);
    box-shadow: inset 0 10px 40px rgba(0, 255, 136, 0.05);
}

.scene-wall {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 55%;
    background: linear-gradient(180deg, #333, #2e2e2e);
}

.rtx-wall {
    background: linear-gradient(180deg, #1a2530, #15202a);
}

.scene-box {
    position: absolute;
    border-radius: 4px;
}

.scene-box.box-1 {
    width: 80px;
    height: 80px;
    bottom: 45%;
    left: 25%;
    background: #555;
    transform: translateY(50%);
}

.scene-box.box-2 {
    width: 60px;
    height: 100px;
    bottom: 45%;
    left: 55%;
    background: #4a4a4a;
    transform: translateY(50%);
}

.scene-box.box-3 {
    width: 120px;
    height: 50px;
    bottom: 45%;
    right: 15%;
    background: #505050;
    transform: translateY(50%);
}

.rtx-box.box-1 {
    background: linear-gradient(135deg, #3a5540, #2a4535);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(0, 255, 136, 0.08);
}

.rtx-box.box-2 {
    background: linear-gradient(135deg, #3a4a55, #2a3a45);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(0, 212, 255, 0.08);
}

.rtx-box.box-3 {
    background: linear-gradient(135deg, #4a4a55, #35354a);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(168, 85, 247, 0.08);
}

.scene-light-flat {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 8px;
    background: #888;
    border-radius: 4px;
}

.scene-light-rtx {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 8px;
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.6), 0 0 80px rgba(0, 255, 136, 0.3);
}

.scene-rays {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 250px;
    background: linear-gradient(180deg,
        rgba(255, 255, 255, 0.08) 0%,
        rgba(0, 255, 136, 0.03) 40%,
        transparent 100%
    );
    clip-path: polygon(35% 0%, 65% 0%, 90% 100%, 10% 100%);
    animation: rayPulse 4s ease-in-out infinite;
}

@keyframes rayPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
}

.scene-reflection {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 45%;
    background: linear-gradient(180deg,
        rgba(0, 255, 136, 0.04) 0%,
        rgba(0, 212, 255, 0.02) 50%,
        transparent 100%
    );
    pointer-events: none;
}

.comparison-label {
    position: absolute;
    bottom: 20px;
    padding: 8px 18px;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 5;
}

.comparison-before .comparison-label {
    left: 20px;
    color: var(--text-muted);
}

.comparison-after .comparison-label {
    right: 20px;
    color: var(--accent-green);
    border-color: rgba(0, 255, 136, 0.2);
}

.comparison-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    z-index: 10;
    transform: translateX(-50%);
}

.handle-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: var(--accent-green);
    transform: translateX(-50%);
    box-shadow: 0 0 10px rgba(0, 255, 136, 0.4);
}

.handle-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: var(--bg-secondary);
    border: 2px solid var(--accent-green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3), var(--shadow-md);
    color: var(--accent-green);
}

.handle-grip svg {
    width: 14px;
    height: 14px;
}

/* Comparison Features */
.comparison-features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 900px;
    margin: 0 auto;
}

.comp-feature {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: var(--transition-base);
}

.comp-feature:hover {
    border-color: var(--border-glow);
    background: var(--bg-card-hover);
}

.comp-feature-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
}

.comp-feature h4 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 4px;
}

.comp-feature p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
}

/* ==========================================
   INSTALLATION STEPS
   ========================================== */
.install-steps {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 900px;
    margin: 0 auto;
}

.install-step {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 32px;
    align-items: start;
    padding: 32px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: var(--transition-base);
}

.install-step:hover {
    border-color: var(--border-glow);
    box-shadow: var(--shadow-glow);
}

.step-number {
    font-size: 3rem;
    font-weight: 900;
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    opacity: 0.4;
}

.step-content h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 10px;
}

.step-content p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 16px;
}

/* Terminal Window */
.terminal-window {
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
}

.terminal-header {
    padding: 10px 14px;
    display: flex;
    gap: 6px;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.terminal-dot.red { background: #ff5f57; }
.terminal-dot.yellow { background: #ffbd2e; }
.terminal-dot.green { background: #28ca42; }

.terminal-body {
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 2;
    overflow: hidden;
}

.terminal-body code {
    color: var(--text-secondary);
}

.t-prompt { color: var(--accent-green); }
.t-cmd { color: var(--accent-cyan); }
.t-success { color: #28ca42; }
.t-dim { color: var(--text-muted); }
.t-accent { color: var(--accent-green); font-weight: 600; }

/* ==========================================
   REQUIREMENTS
   ========================================== */
.req-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
}

.req-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
    position: relative;
}

.req-card-recommended {
    border-color: rgba(0, 255, 136, 0.25);
    background: linear-gradient(135deg, rgba(0, 255, 136, 0.04), rgba(0, 212, 255, 0.02));
    box-shadow: var(--shadow-glow);
}

.req-recommended-badge {
    position: absolute;
    top: -12px;
    left: 32px;
    padding: 4px 16px;
    background: var(--gradient-main);
    color: var(--bg-primary);
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 100px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.req-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 24px;
}

.req-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.req-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.88rem;
}

.req-list li:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.req-key {
    color: var(--text-muted);
    font-weight: 500;
}

.req-val {
    color: var(--text-primary);
    font-weight: 550;
    text-align: right;
}

/* ==========================================
   FAQ
   ========================================== */
.faq-list {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.faq-item {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition-base);
}

.faq-item:hover {
    border-color: rgba(255, 255, 255, 0.1);
}

.faq-item.active {
    border-color: var(--border-glow);
    background: var(--bg-card);
}

.faq-question {
    width: 100%;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.95rem;
    font-weight: 550;
    text-align: left;
    transition: var(--transition-fast);
}

.faq-question:hover {
    color: var(--accent-green);
}

.faq-chevron {
    transition: transform var(--transition-base);
    color: var(--text-muted);
    flex-shrink: 0;
}

.faq-item.active .faq-chevron {
    transform: rotate(180deg);
    color: var(--accent-green);
}

.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                padding 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 0 24px;
}

.faq-item.active .faq-answer {
    max-height: 200px;
    padding: 0 24px 20px;
}

.faq-answer p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
}

/* ==========================================
   CTA SECTION
   ========================================== */
.cta-card {
    position: relative;
    text-align: center;
    padding: 80px 40px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    overflow: hidden;
}

.cta-glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(0, 255, 136, 0.1), transparent 70%);
    pointer-events: none;
}

.cta-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    position: relative;
}

.cta-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 32px;
    line-height: 1.7;
    position: relative;
}

.cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    position: relative;
}

/* ==========================================
   FOOTER
   ========================================== */
.footer {
    padding: 64px 0 32px;
    border-top: 1px solid var(--border-color);
    background: var(--bg-secondary);
    position: relative;
    z-index: 1;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
}

.footer-brand .nav-logo {
    margin-bottom: 16px;
}

.footer-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 300px;
}

.footer-links-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.footer-links-group h4 {
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--text-primary);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.footer-links-group a {
    font-size: 0.88rem;
    color: var(--text-muted);
    transition: var(--transition-fast);
}

.footer-links-group a:hover {
    color: var(--accent-green);
}

.footer-bottom {
    padding-top: 32px;
    border-top: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.footer-bottom p {
    font-size: 0.82rem;
    color: var(--text-muted);
}

.footer-credit {
    color: var(--text-muted);
}

/* ==========================================
   ANIMATIONS (scroll-triggered)
   ========================================== */
[data-animate] {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

[data-animate].animated {
    opacity: 1;
    transform: translateY(0);
}

/* ==========================================
   RESPONSIVE
   ========================================== */

/* Tablet */
@media (max-width: 1024px) {
    .features-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .comparison-features {
        grid-template-columns: repeat(2, 1fr);
    }

    .install-step {
        grid-template-columns: auto 1fr;
    }

    .step-visual {
        grid-column: 1 / -1;
    }

    .footer-content {
        grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }
}

/* Mobile */
@media (max-width: 768px) {
    :root {
        --nav-height: 64px;
    }

    .section {
        padding: 80px 0;
    }

    .nav-links {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 16px;
        background: rgba(5, 10, 14, 0.97);
        backdrop-filter: blur(20px);
        transform: translateX(100%);
        transition: transform var(--transition-base);
        z-index: 5;
    }

    .nav-links.open {
        transform: translateX(0);
    }

    .nav-link {
        font-size: 1.2rem;
        padding: 12px 24px;
    }

    .nav-actions {
        display: none;
    }

    .nav-toggle {
        display: flex;
    }

    .hero {
        padding-top: calc(var(--nav-height) + 24px);
    }

    .hero-title {
        font-size: clamp(2.2rem, 8vw, 3.5rem);
    }

    .hero-stats {
        gap: 24px;
    }

    .stat-number {
        font-size: 1.5rem;
    }

    .hero-mockup {
        transform: none;
    }

    .mockup-sidebar {
        display: none;
    }

    .features-grid {
        grid-template-columns: 1fr;
    }

    .comparison-slider {
        height: 280px;
    }

    .comparison-features {
        grid-template-columns: 1fr;
    }

    .install-step {
        grid-template-columns: 1fr;
        gap: 20px;
        padding: 24px;
    }

    .step-number {
        font-size: 2rem;
    }

    .req-grid {
        grid-template-columns: 1fr;
    }

    .footer-content {
        grid-template-columns: 1fr;
        gap: 32px;
    }

    .footer-bottom {
        flex-direction: column;
        gap: 8px;
        text-align: center;
    }

    .cta-card {
        padding: 48px 24px;
    }

    .hero-buttons {
        flex-direction: column;
        width: 100%;
    }

    .hero-buttons .btn {
        width: 100%;
        justify-content: center;
    }
}

/* Small Mobile */
@media (max-width: 480px) {
    .hero-stats {
        flex-direction: column;
        gap: 16px;
    }

    .stat-divider {
        width: 40px;
        height: 1px;
    }

    .mockup-info-grid {
        grid-template-columns: 1fr;
    }
}
